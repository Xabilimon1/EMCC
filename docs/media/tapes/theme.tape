# Anthropic's palette (brand-guidelines): #141413 dark, #faf9f5 light, #b0aea5 mid gray,
# #e8e6dc light gray; accents #d97757, #6a9bcc, #788c5d. The other ANSI slots are tints of those.
Set Shell zsh
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 18
Set Width 1440
Set Height 820
Set Padding 28
Set Margin 0
Set WindowBar ""
Set CursorBlink false
Set TypingSpeed 45ms
Set Theme { "name": "Anthropic", "background": "#141413", "foreground": "#faf9f5", "cursor": "#d97757", "selection": "#3a3936", "black": "#141413", "brightBlack": "#5e5d59", "red": "#d97757", "brightRed": "#e3937a", "green": "#788c5d", "brightGreen": "#93a676", "yellow": "#d4a27f", "brightYellow": "#e3bd9f", "blue": "#6a9bcc", "brightBlue": "#8bb2da", "magenta": "#a98ea0", "brightMagenta": "#c1a9b9", "cyan": "#7fa29f", "brightCyan": "#9dbbb8", "white": "#e8e6dc", "brightWhite": "#faf9f5" }
